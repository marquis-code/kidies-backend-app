# API
PORT=3005
NODE_ENV=development

# Database
MONGODB_URI="mongodb://localhost:27017/jasmarkids"

# Auth
JWT_SECRET="change-me-in-production"

# Storefront / admin URLs (used in payment callbacks and emails)
FRONTEND_URL="http://localhost:3100"
ADMIN_URL="http://localhost:3200"
PUBLIC_API_URL="http://localhost:3005"

# Payments — keep mock mode on for local development
PAYMENTS_MOCK=true
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_URL=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend) — optional. When unset, OTP/reset codes are logged and returned in dev.
RESEND_API_KEY=""
EMAIL_FROM="JasmarKids <noreply@jasmarkids.com>"

# Uploads (Cloudinary) — optional. Falls back to backend/uploads when unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase admin (social login)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
